---
import BaseLayout from "~/layouts/BaseLayout.astro";
import RelatedCalculators from "~/components/RelatedCalculators.astro";
import { getCollection, render } from "astro:content";
import { SITE_NAME, SITE_URL } from "~/lib/seo";
import { AUTHOR } from "~/lib/site";
import { DEFAULT_LOCALE } from "~/i18n/config";
import { getLocalizedCalculator } from "~/lib/localized";
import { guideHref, guidesHref, homeHref, type PageRef } from "~/i18n/routing";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const url = `${SITE_URL}${guideHref(guide.id)}`;
const seo = {
  title: `${guide.data.title} | ${SITE_NAME}`,
  description: guide.data.description,
  canonical: url,
};
const pageRef: PageRef = { kind: "guide", slug: guide.id };

const calculators = guide.data.calculators
  .map((slug) => getLocalizedCalculator(DEFAULT_LOCALE, slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const toc = headings.filter((h) => h.depth === 2);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  url,
  mainEntityOfPage: url,
  datePublished: guide.data.published.toISOString(),
  dateModified: (guide.data.updated ?? guide.data.published).toISOString(),
  inLanguage: "en",
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  publisher: { "@type": "Organization", name: "StorageCalc", url: SITE_URL },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Guides", item: `${SITE_URL}${guidesHref()}` },
    { "@type": "ListItem", position: 3, name: guide.data.title, item: url },
  ],
};
---

<BaseLayout seo={seo} schemas={[articleSchema, breadcrumb]} locale={DEFAULT_LOCALE} pageRef={pageRef}>
  <section class="gradient-hero border-b border-slate-100">
    <div class="container-wide py-10 sm:py-14">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={homeHref(DEFAULT_LOCALE)} class="hover:text-brand-700">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href={guidesHref()} class="hover:text-brand-700">Guides</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-slate-700" aria-current="page">{guide.data.title}</li>
        </ol>
      </nav>
      <h1 class="mt-6 max-w-3xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">{guide.data.title}</h1>
      <p class="mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">{guide.data.description}</p>
      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500">
        <span>By <a href={AUTHOR.url} rel="author" class="font-semibold text-slate-800 hover:text-brand-700">{AUTHOR.name}</a></span>
        <span>Published {fmtDate(guide.data.published)}</span>
        {guide.data.updated && <span>Updated {fmtDate(guide.data.updated)}</span>}
        <span>{guide.data.readingMinutes} min read</span>
      </p>
    </div>
  </section>

  <section class="container-wide py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <article class="prose-app lg:col-span-2">
        <Content />
        <div class="not-prose mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="text-sm font-semibold text-slate-900">About the author</p>
          <p class="mt-1 text-sm text-slate-600"><strong>{AUTHOR.name}</strong>, {AUTHOR.role}. {AUTHOR.affiliation}, {AUTHOR.location}. {AUTHOR.bio} <a href={AUTHOR.linkedin} rel="me noopener" target="_blank" class="underline hover:text-brand-700">LinkedIn ↗</a>. Spotted a mistake? <a href="/contact/" class="underline hover:text-brand-700">Tell me</a> and it gets fixed.</p>
        </div>
      </article>

      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-6">
          {toc.length > 1 && (
            <nav class="rounded-2xl border border-slate-200 bg-white p-5" aria-label="On this page">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">On this page</p>
              <ol class="mt-3 space-y-2 text-sm">
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`} class="text-slate-700 hover:text-brand-700">{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
          {calculators.length > 0 && (
            <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Try the numbers yourself</p>
              <ul class="mt-3 space-y-2">
                {calculators.map((c) => (
                  <li>
                    <a href={`/${c.slug}/`} class="block rounded-lg bg-white px-3 py-2 text-sm font-medium text-slate-800 ring-1 ring-brand-100 hover:text-brand-700">{c.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </section>

  {calculators.length > 0 && (
    <section class="bg-white py-12 sm:py-16">
      <div class="container-wide">
        <RelatedCalculators calculators={calculators} locale={DEFAULT_LOCALE} />
      </div>
    </section>
  )}
</BaseLayout>
