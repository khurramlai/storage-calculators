---
import CalculatorPage from "~/components/pages/CalculatorPage.astro";
import { getLocalizedCalculators } from "~/lib/localized";
import { DEFAULT_LOCALE } from "~/i18n/config";

export async function getStaticPaths() {
  return getLocalizedCalculators(DEFAULT_LOCALE).map((calc) => ({
    params: { slug: calc.localizedSlug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
---

<CalculatorPage calc={calc} locale={DEFAULT_LOCALE} />
