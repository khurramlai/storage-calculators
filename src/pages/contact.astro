---
import LegalLayout from "~/layouts/LegalLayout.astro";
import { SITE_NAME, SITE_URL } from "~/lib/seo";
import { CONTACT_EMAIL, AUTHOR } from "~/lib/site";
import type { PageRef } from "~/i18n/routing";
import { DEFAULT_LOCALE } from "~/i18n/config";

const seo = {
  title: `Contact | ${SITE_NAME}`,
  description:
    "How to reach the person behind StorageCalc: report a wrong formula or outdated price, request a calculator, or ask a question about the site.",
  canonical: `${SITE_URL}/contact/`,
};

const pageRef: PageRef = { kind: "static", key: "contact" };
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const formConfigured = accessKey && accessKey !== "YOUR_WEB3FORMS_ACCESS_KEY_HERE";
---

<LegalLayout
  seo={seo}
  locale={DEFAULT_LOCALE}
  pageRef={pageRef}
  eyebrow="Contact"
  title="Contact"
  subtitle="One person runs this site and reads every message. Corrections to the math get answered first."
>
  <h2>Email</h2>
  <p>
    The fastest way to reach me is email:
    <a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a>
  </p>
  <p>I usually reply within two working days. If you're reporting an error, I'll tell you when the fix is live.</p>

  <h2>What to include</h2>
  <ul>
    <li><strong>Wrong result or formula:</strong> the calculator page, the inputs you used, the number you got, and the number you expected. A link to the vendor document you're comparing against saves a round trip.</li>
    <li><strong>Outdated price or spec:</strong> which provider or camera model, and where the current figure is published.</li>
    <li><strong>Calculator request:</strong> what you're trying to size and what inputs you have to hand. If the math is publicly documented, it's usually a quick addition.</li>
    <li><strong>Site bug:</strong> browser, device, and what you clicked.</li>
  </ul>

  {formConfigured && (
    <>
      <h2>Or use this form</h2>
      <form
        class="not-prose mt-4 space-y-4 rounded-2xl border border-slate-200 bg-white p-6"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Contact form: StorageCalc" />
        <input type="hidden" name="from_name" value="StorageCalc contact" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div>
          <label for="contact-email" class="mb-1 block text-sm font-medium text-slate-800">Your email</label>
          <input id="contact-email" type="email" name="email" required autocomplete="email" class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" />
        </div>
        <div>
          <label for="contact-message" class="mb-1 block text-sm font-medium text-slate-800">Message</label>
          <textarea id="contact-message" name="message" required rows="6" minlength="10" maxlength="4000" class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"></textarea>
        </div>
        <button type="submit" class="btn-primary">Send message</button>
      </form>
    </>
  )}

  <h2>Who you're writing to</h2>
  <p><strong>{AUTHOR.name}</strong>, {AUTHOR.role}. {AUTHOR.affiliation}. Based in {AUTHOR.location}. {AUTHOR.bio}</p>
  <p><a href={AUTHOR.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a> · <a href="/about/#author">More on the About page</a>.</p>

  <h2>What I can't help with</h2>
  <ul>
    <li>Vendor support. I don't work for Hikvision, Ubiquiti, AWS, or anyone else whose products appear here. For a faulty NVR or a billing dispute, contact the vendor.</li>
    <li>Advertising or sponsored placement. Nothing on this site is paid for by a vendor, and that isn't going to change.</li>
    <li>Link exchange or guest post requests. These are not answered.</li>
  </ul>

  <h2>Privacy</h2>
  <p>Messages are used only to answer you and to fix whatever you reported. They're not added to any list. See the <a href="/privacy-policy/">Privacy Policy</a>.</p>
</LegalLayout>
