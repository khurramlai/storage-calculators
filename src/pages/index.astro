---
import BaseLayout from "~/layouts/BaseLayout.astro";
import CalculatorCard from "~/components/CalculatorCard.astro";
import CategoryIcon from "~/components/CategoryIcon.astro";
import {
  getAllCalculators,
  getCalculatorsByCategory,
  CATEGORY_LABELS,
} from "~/lib/registry";
import { siteSeo, SITE_NAME } from "~/lib/seo";
import type { CalculatorCategory } from "~/lib/types";

const all = getAllCalculators();
const seo = siteSeo();

const categories = Object.entries(CATEGORY_LABELS) as [CalculatorCategory, string][];
const categoriesWithData = categories
  .map(([key, label]) => ({ key, label, count: getCalculatorsByCategory(key).length }))
  .filter((c) => c.count > 0);

const featuredSlugs = [
  "raid-storage-calculator",
  "cctv-storage-calculator",
  "s3-storage-calculator",
  "nvr-storage-calculator",
  "azure-storage-calculator",
  "hikvision-storage-calculator",
];
const featured = featuredSlugs
  .map((s) => all.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const stats = [
  { value: `${all.length}+`, label: "Calculators" },
  { value: `${categoriesWithData.length}`, label: "Categories" },
  { value: "$0", label: "Ever" },
  { value: "No signup", label: "Required" },
];

const features = [
  {
    icon: "✓",
    accent: "bg-emerald-50 text-emerald-600 ring-emerald-100",
    title: "Industry-standard formulas",
    body: "Math sourced from public vendor docs: Hikvision, Hanwha, Axis, AWS, Azure, GCP. Verified against published planning numbers.",
  },
  {
    icon: "★",
    accent: "bg-amber-50 text-amber-600 ring-amber-100",
    title: "Vendor-aware presets",
    body: "Hikvision page defaults to H.265+. UniFi defaults to G4 Pro at 4 MP. Azure defaults to Hot. Real defaults, not toy examples.",
  },
  {
    icon: "⚡",
    accent: "bg-brand-50 text-brand-600 ring-brand-100",
    title: "Instant, no signup",
    body: "Calculations run in your browser as you type. No accounts, no email gates, no marketing follow-ups.",
  },
  {
    icon: "🔒",
    accent: "bg-violet-50 text-violet-600 ring-violet-100",
    title: "Privacy-first",
    body: "Static site, no backend, no analytics until you accept. Your inputs never leave your device.",
  },
  {
    icon: "↻",
    accent: "bg-sky-50 text-sky-600 ring-sky-100",
    title: "Visual comparisons",
    body: "Capacity breakdowns, codec savings charts, tier-by-tier cost bars. See the trade-off, don't read it.",
  },
  {
    icon: "❖",
    accent: "bg-pink-50 text-pink-600 ring-pink-100",
    title: "Mobile-friendly",
    body: "Every calculator works on phones. Useful when you're already in the server room or at the storage unit.",
  },
];
---

<BaseLayout seo={seo}>
  <!-- HERO -->
  <section class="gradient-hero relative overflow-hidden">
    <!-- Decorative gradient blobs -->
    <div class="pointer-events-none absolute -top-32 -right-24 h-96 w-96 rounded-full bg-gradient-to-br from-violet-200/70 to-pink-200/40 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-gradient-to-br from-brand-200/60 to-sky-200/30 blur-3xl" aria-hidden="true"></div>

    <div class="container-wide relative py-20 sm:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="eyebrow">
            <span class="eyebrow-dot"></span>
            {all.length} free storage calculators
          </span>
          <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Storage math, <span class="gradient-text">instantly solved</span>.
          </h1>
          <p class="mt-5 max-w-xl text-lg text-slate-600">
            Accurate calculators for RAID, NAS, surveillance, and cloud storage,
            powered by published vendor specs. No signup, no fluff, no overpromises.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="/raid-storage-calculator/" class="btn-primary">
              Start with RAID
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
            </a>
            <a href="#all" class="btn-secondary">Browse all calculators</a>
          </div>
          <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            {
              stats.map((s) => (
                <div>
                  <div class="font-mono text-2xl font-bold text-slate-900 sm:text-3xl">{s.value}</div>
                  <div class="text-xs uppercase tracking-wide text-slate-500">{s.label}</div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Visual preview card -->
        <div class="lg:col-span-5">
          <div class="relative">
            <div class="absolute -inset-6 rounded-3xl bg-gradient-to-br from-brand-400/20 via-violet-400/15 to-pink-400/20 blur-2xl" aria-hidden="true"></div>
            <div class="relative rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl shadow-brand-900/10">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                </div>
                <span class="font-mono text-xs text-slate-400">/raid-storage-calculator</span>
              </div>
              <div class="mt-5">
                <div class="text-xs uppercase tracking-wide text-brand-600">RAID 6, 8 × 8 TB</div>
                <div class="mt-1 font-mono text-4xl font-bold text-slate-900">48.00 TB</div>
                <div class="text-xs text-slate-500">usable capacity · survives 2 drive failures</div>
              </div>
              <div class="mt-5 space-y-2">
                <div class="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-xs">
                  <span class="text-slate-600">Read speed</span>
                  <span class="font-mono font-semibold text-slate-900">6.00×</span>
                </div>
                <div class="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-xs">
                  <span class="text-slate-600">Write speed</span>
                  <span class="font-mono font-semibold text-slate-900">1.00×</span>
                </div>
                <div class="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-xs">
                  <span class="text-slate-600">Efficiency</span>
                  <span class="font-mono font-semibold text-slate-900">75.0%</span>
                </div>
              </div>
              <div class="mt-5 flex h-3 w-full overflow-hidden rounded-full ring-1 ring-slate-200">
                <div class="flex-1 bg-brand-600" style="flex: 6"></div>
                <div class="bg-amber-500" style="flex: 2"></div>
              </div>
              <div class="mt-2 flex items-center justify-between text-[11px] text-slate-500">
                <span>Usable 75%</span>
                <span>Parity 25%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="border-y border-slate-100 bg-white">
    <div class="container-wide py-6">
      <p class="text-center text-xs font-semibold uppercase tracking-wider text-slate-400">
        Math sourced from public docs of
      </p>
      <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-semibold text-slate-500">
        <li>Hikvision</li>
        <li class="text-slate-300">·</li>
        <li>Hanwha Wisenet</li>
        <li class="text-slate-300">·</li>
        <li>Axis</li>
        <li class="text-slate-300">·</li>
        <li>UniFi Protect</li>
        <li class="text-slate-300">·</li>
        <li>AWS S3</li>
        <li class="text-slate-300">·</li>
        <li>Azure Blob</li>
        <li class="text-slate-300">·</li>
        <li>Google Cloud Storage</li>
      </ul>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="container-wide py-20">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><span class="eyebrow-dot"></span>Pick a category</span>
      <h2 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">Six clusters, twenty calculators</h2>
      <p class="mt-3 text-slate-600">Every calculator targets a specific search and audience. Pick the category that matches what you're sizing.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categoriesWithData.map(({ key, label, count }) => (
          <a
            href={`#${key}`}
            class="card card-hover group flex items-start gap-4 p-5"
          >
            <span class={`accent-${key} inline-flex h-12 w-12 items-center justify-center rounded-2xl ring-1`}>
              <CategoryIcon category={key} class="h-6 w-6" />
            </span>
            <div class="flex-1">
              <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand-700">{label}</h3>
              <p class="mt-0.5 text-sm text-slate-500">
                {count} calculator{count === 1 ? "" : "s"}
              </p>
            </div>
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-brand-600">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
        ))
      }
    </div>
  </section>

  <!-- FEATURED -->
  {
    featured.length > 0 && (
      <section class="bg-white py-20">
        <div class="container-wide">
          <div class="mb-10 flex items-end justify-between gap-6">
            <div>
              <span class="eyebrow"><span class="eyebrow-dot"></span>Most useful</span>
              <h2 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">Featured calculators</h2>
            </div>
            <a href="#all" class="btn-ghost hidden sm:inline-flex">
              See all
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
            </a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((c) => <CalculatorCard calc={c} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- FEATURES / WHY -->
  <section class="container-wide py-20">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><span class="eyebrow-dot"></span>Why these calculators</span>
      <h2 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">Built right, kept free</h2>
      <p class="mt-3 text-slate-600">Vendor calculators hide the formula and try to upsell you. These don't.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="card p-6">
            <span class={`inline-flex h-10 w-10 items-center justify-center rounded-xl text-lg font-bold ring-1 ${f.accent}`}>
              {f.icon}
            </span>
            <h3 class="mt-4 text-base font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-1 text-sm text-slate-600">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ALL CALCULATORS -->
  <section id="all" class="bg-white py-20">
    <div class="container-wide">
      <div class="mb-10 max-w-2xl">
        <span class="eyebrow"><span class="eyebrow-dot"></span>The full library</span>
        <h2 class="mt-4 text-3xl font-bold text-slate-900 sm:text-4xl">All calculators</h2>
        <p class="mt-3 text-slate-600">Organized by category. Pick the one closest to your use case.</p>
      </div>
      {
        all.length === 0 ? (
          <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-12 text-center text-slate-500">
            <p class="text-lg font-medium text-slate-700">No calculators yet</p>
          </div>
        ) : (
          categoriesWithData.map(({ key, label }) => {
            const list = getCalculatorsByCategory(key);
            return (
              <section id={key} class="mb-14 scroll-mt-24">
                <div class="mb-5 flex items-center gap-3">
                  <span class={`accent-${key} inline-flex h-9 w-9 items-center justify-center rounded-xl ring-1`}>
                    <CategoryIcon category={key} class="h-4 w-4" />
                  </span>
                  <h3 class="text-xl font-bold text-slate-900">{label}</h3>
                  <span class="text-sm text-slate-400">· {list.length} calculator{list.length === 1 ? "" : "s"}</span>
                </div>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {list.map((calc) => <CalculatorCard calc={calc} />)}
                </div>
              </section>
            );
          })
        )
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide pb-20">
    <div class="relative overflow-hidden rounded-3xl gradient-cta p-10 text-white shadow-2xl shadow-brand-700/20 sm:p-14">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-24 -bottom-24 h-72 w-72 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-bold sm:text-4xl">Find the right calculator for your storage need.</h2>
        <p class="mt-3 text-white/85">From 4-drive home NAS to 64-camera surveillance racks to multi-petabyte cloud archives, there's a calculator above for it.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/raid-storage-calculator/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 shadow-sm transition hover:bg-slate-50">
            Open RAID calculator
          </a>
          <a href="#all" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">
            Browse the library
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
