---
// Lightweight cookie consent banner. No external SDK; choice persisted in
// localStorage under "consent". Analytics scripts should check
// window.__consent === "accepted" before loading (see BaseLayout).
---

<div
  id="cookie-banner"
  class="fixed inset-x-3 bottom-3 z-40 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-2xl shadow-slate-900/10 sm:left-auto sm:right-4 sm:max-w-md"
  role="dialog"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-desc"
>
  <div class="flex items-start gap-3">
    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path d="M21.6 11.2a4 4 0 01-4.8-4.8 5 5 0 01-3-3A10 10 0 1022 12a9.8 9.8 0 00-.4-.8zM8 16a1 1 0 11-1-1 1 1 0 011 1zm1-5a1.5 1.5 0 11-1.5-1.5A1.5 1.5 0 019 11zm6 6a1.5 1.5 0 11-1.5-1.5 1.5 1.5 0 011.5 1.5z" />
      </svg>
    </span>
    <div class="min-w-0 flex-1">
      <p id="cookie-banner-title" class="text-sm font-semibold text-slate-900">Cookies & analytics</p>
      <p id="cookie-banner-desc" class="mt-1 text-xs text-slate-600">
        We use Google Analytics to understand which calculators are useful, and may show Google ads
        to keep this free. Nothing personal is collected. See
        <a href="/cookie-policy/" class="underline hover:text-brand-700">Cookie Policy</a>.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="btn-primary text-xs" data-consent="accepted">Accept</button>
        <button type="button" class="btn-secondary text-xs" data-consent="rejected">Reject</button>
      </div>
    </div>
    <button
      type="button"
      class="-m-1 inline-flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-700"
      aria-label="Dismiss"
      data-consent="dismissed"
    >
      <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var key = "consent";
    var stored = null;
    try { stored = localStorage.getItem(key); } catch (_) { /* private mode */ }
    window.__consent = stored;

    function setConsent(value) {
      try { localStorage.setItem(key, value); } catch (_) {}
      window.__consent = value;
      var banner = document.getElementById("cookie-banner");
      if (banner) banner.classList.add("hidden");
      // When real GA/Ads scripts are added, dispatch this event and load them in response.
      window.dispatchEvent(new CustomEvent("consent:change", { detail: value }));
    }

    if (!stored) {
      var banner = document.getElementById("cookie-banner");
      if (banner) banner.classList.remove("hidden");
    }

    document.querySelectorAll("[data-consent]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        setConsent(btn.getAttribute("data-consent") || "dismissed");
      });
    });
  })();
</script>
