---
import type { CalculatorConfig } from "~/lib/types";
import CategoryIcon from "./CategoryIcon.astro";
import { DEFAULT_LOCALE, type Locale } from "~/i18n/config";
import { strings } from "~/i18n";
import { calculatorHref } from "~/i18n/routing";

interface Props {
  calc: CalculatorConfig;
  locale?: Locale;
}
const { calc, locale = DEFAULT_LOCALE } = Astro.props;
const s = strings(locale);
---

<a
  href={calculatorHref(locale, calc.slug)}
  class="card card-hover group flex h-full flex-col p-5"
>
  <div class="flex items-start justify-between gap-3">
    <span class={`accent-${calc.category} inline-flex h-10 w-10 items-center justify-center rounded-xl ring-1`}>
      <CategoryIcon category={calc.category} class="h-5 w-5" />
    </span>
    <span class={`accent-${calc.category} rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ring-1`}>
      {s.category[calc.category]}
    </span>
  </div>
  <h3 class="mt-4 text-base font-semibold text-slate-900 group-hover:text-brand-700">
    {calc.title}
  </h3>
  <p class="mt-1 flex-1 text-sm text-slate-600 line-clamp-3">
    {calc.description}
  </p>
  <div class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
    {s.common.openCalculator}
    <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition group-hover:translate-x-0.5 rtl:-scale-x-100">
      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
    </svg>
  </div>
</a>
