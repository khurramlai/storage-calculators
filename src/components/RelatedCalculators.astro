---
import type { CalculatorConfig } from "~/lib/types";
import CalculatorCard from "./CalculatorCard.astro";
import { DEFAULT_LOCALE, type Locale } from "~/i18n/config";
import { strings } from "~/i18n";

interface Props {
  calculators: CalculatorConfig[];
  locale?: Locale;
}
const { calculators, locale = DEFAULT_LOCALE } = Astro.props;
const s = strings(locale);
---

{
  calculators.length > 0 && (
    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">{s.common.relatedHeading}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {calculators.map((c) => <CalculatorCard calc={c} locale={locale} />)}
      </div>
    </section>
  )
}
