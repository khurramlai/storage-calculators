---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { staticPageSeo } from "~/lib/seo";
import type { Locale } from "~/i18n/config";
import type { PageRef } from "~/i18n/routing";
import type { StaticPageKey, StaticPageTranslation } from "~/i18n/types";

interface Props {
  page: StaticPageTranslation;
  pageKey: StaticPageKey;
  locale: Locale;
}

const { page, pageKey, locale } = Astro.props;
const seo = staticPageSeo(pageKey, page.title, page.description, locale);
const pageRef: PageRef = { kind: "static", key: pageKey };
const heading = page.heading ?? page.title;
---

<BaseLayout seo={seo} locale={locale} pageRef={pageRef}>
  <section class="gradient-hero border-b border-slate-100">
    <div class="container-default py-12 sm:py-16">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{heading}</h1>
      {page.subtitle && <p class="mt-3 max-w-2xl text-slate-600">{page.subtitle}</p>}
      {page.updated && (
        <p class="mt-4 text-xs text-slate-500">{page.updated}</p>
      )}
    </div>
  </section>

  <article class="container-default prose-app py-12 sm:py-16" set:html={page.body} />
</BaseLayout>
