---
import type { FAQItem } from "~/lib/types";
interface Props {
  faqs: FAQItem[];
}
const { faqs } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="mt-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-slate-200 bg-white p-4 open:shadow-sm">
            <summary class="cursor-pointer list-none font-medium text-slate-900 marker:hidden">
              <div class="flex items-center justify-between gap-4">
                <span>{faq.question}</span>
                <span
                  class="text-slate-400 transition group-open:rotate-180"
                  aria-hidden="true"
                >
                  ▾
                </span>
              </div>
            </summary>
            <div class="mt-3 text-slate-700 leading-relaxed" set:html={faq.answer} />
          </details>
        ))}
      </div>
    </section>
  )
}
