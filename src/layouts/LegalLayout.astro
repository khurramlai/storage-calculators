---
import BaseLayout from "./BaseLayout.astro";
import type { SeoMeta } from "~/lib/seo";

interface Props {
  seo: SeoMeta;
  title: string;
  subtitle?: string;
  updated?: string;
}

const { seo, title, subtitle, updated } = Astro.props;
---

<BaseLayout seo={seo}>
  <section class="gradient-hero border-b border-slate-100">
    <div class="container-default py-12 sm:py-16">
      <span class="eyebrow"><span class="eyebrow-dot"></span>Legal</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
      {subtitle && <p class="mt-3 max-w-2xl text-slate-600">{subtitle}</p>}
      {updated && (
        <p class="mt-4 text-xs text-slate-500">Last updated: {updated}</p>
      )}
    </div>
  </section>

  <article class="container-default prose-app py-12 sm:py-16">
    <slot />
  </article>
</BaseLayout>
