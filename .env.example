# Copy this file to .env and fill in real values. .env is gitignored.

# Web3Forms access key for the feedback form on each calculator page.
# Get a free key at https://web3forms.com (you give them your email, they give you
# a key, every form submission gets emailed to you). Free tier is 250 submissions/mo.
PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY_HERE
